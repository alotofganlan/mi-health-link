# Supabase server-side settings.
# Keep these ONLY on your VPS. Use a Secret key or legacy service-role key.
# Never paste the server-side key into ChatGPT or client-side code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_KEY

# Xiaomi region: cn / sg / us / de / ru / i2
XIAOMI_REGION=cn

# Path to locally stored Xiaomi session credentials.
XIAOMI_CREDENTIALS_FILE=./xiaomi-credentials.json

# Optional custom User-Agent. The default mimics current Mi Fitness traffic.
XIAOMI_USER_AGENT=

# Optional account-level session source for automatic Xiaomi Cloud refresh.
# Keep these only on the VPS; never paste passToken into chat or Git.
XIAOMI_PASS_TOKEN=
XIAOMI_DEVICE_ID=

# Optional ntfy alert when Xiaomi Cloud rejects the saved session.
# Use a full topic URL. Token is optional for an unprotected topic.
XIAOMI_AUTH_NTFY_URL=https://ntfy.example/xiaomi-health-auth
XIAOMI_AUTH_NTFY_TOKEN=
XIAOMI_AUTH_NTFY_COOLDOWN_SECONDS=21600
# Optional; defaults to ~/.local/state/xiaomi-health-sync/xiaomi-auth-ntfy.json
XIAOMI_AUTH_NTFY_STATE_FILE=

# Nightscout glucose source. Token is optional for public/readable instances.
NIGHTSCOUT_URL=https://your-nightscout.example
NIGHTSCOUT_TOKEN=

# 早安我的少年：由手机 Automate 每次解锁时调用 wake-probe。
# 真实令牌只保存在 VPS 的 .env，不能提交到 Git。
WAKE_PROBE_TOKEN=
WAKE_PROBE_DEVICE=primary_phone
WAKE_PROBE_SYNC_COOLDOWN_SECONDS=720
WAKE_UNLOCK_WINDOW_MINUTES=120
WAKE_LOCATION_WINDOW_MINUTES=120
WAKE_TIMEZONE=Asia/Shanghai
WAKE_FIRST_REPORT_TIME=05:00
# 可选：城市级反向地理编码和 VPS 天气服务地址。
WAKE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
WAKE_WEATHER_URL=https://api.open-meteo.com/v1/forecast
# Slack 只发送触发信号；睡眠、城市和天气由报告编号读取。
MORNING_REPORT_CMD=python slack_morning_report.py
MORNING_REPORT_TIMEOUT_SECONDS=300
# 优先使用用户 OAuth 令牌发送；仅未配置用户令牌时才使用旧 webhook。
SLACK_USER_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=

# Xiaomi Health MCP server settings.
# Public endpoint for the deployed MCP server.
MCP_PUBLIC_URL=https://health.example.com/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Supabase Auth OAuth 2.1 resource-server settings.
SUPABASE_AUTH_ISSUER_URL=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_AUTH_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AUTH_AUDIENCE=authenticated
MCP_ALLOWED_SUBJECT=00000000-0000-0000-0000-000000000000
MCP_REQUIRED_SCOPES=openid

# Browser-safe settings used only by the OAuth consent page.
# In Supabase Auth, set Site URL to https://health.example.com
# and OAuth Server Authorization Path to /oauth/consent.
SUPABASE_PROJECT_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
